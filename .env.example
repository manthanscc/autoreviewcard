# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Service (server-side only — do NOT use VITE_ prefix)
SARVAM_API_KEY=your_sarvam_api_key

# Application Configuration
VITE_APP_NAME="SCC INFOTECH LLP - Review Automation"
VITE_APP_DESCRIPTION="Streamline your Google Maps reviews with automated review system"

# Development Configuration
VITE_DEV_MODE="true"

# Optional: comma-separated allowed origins for /api/sarvam
# ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com
# APP_URL=https://your-domain.com
